# Backend
ENVIRONMENT=develop
PORT=8081

# PostgreSQL
POSTGRES_USER=myuser
POSTGRES_PASSWORD=
POSTGRES_DB=mydb
POSTGRES_PORT=5436

# Redis
REDIS_PASSWORD=
REDIS_DB=0
REDIS_PORT=6379

# Frontend
FE_PORT=3000
FE_URL=http://localhost:3000
VITE_API_URL=http://localhost:8081
VITE_VIDEO_POLLING_INTERVAL_MS=2000

# Cookie
COOKIE_SECURE=false
COOKIE_DOMAIN=

# Authentication secrets
# JWT_SECRET / REFRESH_TOKEN_HMAC_KEY / RATE_LIMIT_HMAC_KEY must each be at least 32 bytes.
JWT_SECRET=
REFRESH_TOKEN_HMAC_KEY=
RATE_LIMIT_HMAC_KEY=

# Administrator
ADMIN_NAME=管理者
ADMIN_EMAIL=admin@local.example
ADMIN_PASSWORD=

# MinIO
MINIO_ROOT_USER=coffee-reel-example
MINIO_ROOT_PASSWORD=
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Object Storage
# For the current local MinIO setup, use the same values as MINIO_ROOT_USER / MINIO_ROOT_PASSWORD.
STORAGE_PROVIDER=s3
STORAGE_REGION=us-east-1
STORAGE_BUCKET=coffee-reel-example
STORAGE_ACCESS_KEY_ID=coffee-reel-example
STORAGE_SECRET_ACCESS_KEY=
STORAGE_FORCE_PATH_STYLE=true
STORAGE_MANAGED_PREFIX=videos/
STORAGE_UPLOAD_URL_TTL=15m
STORAGE_READ_URL_TTL=10m

# Video upload idempotency
# VIDEO_IDEMPOTENCY_HMAC_KEY must be at least 32 bytes.
VIDEO_IDEMPOTENCY_TTL=24h
VIDEO_IDEMPOTENCY_HMAC_KEY=
VIDEO_IDEMPOTENCY_KEY_MAX_BYTES=128

# FFmpeg / FFprobe paths inside the worker container
FFPROBE_PATH=/usr/bin/ffprobe
FFMPEG_PATH=/usr/bin/ffmpeg

# Worker retry policy
VIDEO_PROCESSING_RETRY_DELAYS=10s,30s,1m
STORAGE_CLEANUP_RETRY_DELAYS=10s,30s,1m
STORAGE_CLEANUP_TIMEOUT=30s

# Orphan object detection
STORAGE_ORPHAN_MIN_AGE=1h
STORAGE_ORPHAN_LIST_LIMIT=100

# Worker loops
WORKER_PROCESSING_CONCURRENCY=1
WORKER_PROCESSING_POLL_INTERVAL=2s
WORKER_CLEANUP_POLL_INTERVAL=2s
WORKER_UPLOAD_EXPIRY_INTERVAL=1m
WORKER_UPLOAD_EXPIRY_LIMIT=100
WORKER_PROCESSING_RECOVERY_INTERVAL=1m
WORKER_PROCESSING_RECOVERY_LIMIT=100
WORKER_CLEANUP_RECOVERY_INTERVAL=1m
WORKER_CLEANUP_RECOVERY_LIMIT=100
WORKER_ORPHAN_DETECTION_INTERVAL=1h
WORKER_IDEMPOTENCY_CLEANUP_INTERVAL=10m
WORKER_IDEMPOTENCY_CLEANUP_LIMIT=100
